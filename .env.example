# Environment configuration for foxess-local
# Copy to .env and fill in your values.
# .env is gitignored — never commit it.

# FoxESS monitoring server (default works for most deployments)
FOXESS_UPSTREAM_HOST=47.91.86.144  # Known FoxESS server (public)
FOXESS_UPSTREAM_PORT=14431

# Your local relay host (the machine running foxess-relay)
FOXESS_RELAY_HOST=your-relay-host-ip

# UniFi controller
UNIFI_URL=https://your-router-ip
UNIFI_TOKEN=your-api-token-here

# FoxESS dongle MAC address
FOXESS_DONGLE_MAC=your-dongle-mac-address

# IoT VLAN isolation (for foxess-network command)
IOT_VLAN_ID=3
IOT_SUBNET=192.168.3.1/24
IOT_SSID_NAME=your-iot-wifi-name
IOT_SSID_PASSWORD=your-iot-wifi-password
IOT_DONGLE_FIXED_IP=192.168.3.206

# FoxESS Cloud API (optional, for cross-referencing)
FOXESS_API_KEY=your-foxess-api-key-here
FOXESS_DEVICE_SN=your-device-serial-number
